# === Threads Graph API ===
# Threads user access token (long-lived, ~60 ngay).
# Cach lay: xem docs/SETUP.md
THREADS_ACCESS_TOKEN=

# === Telegram ===
# Token bot lay tu @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID nhan canh bao (dang so hoac @username channel)
TELEGRAM_CHAT_ID=

# === Chu ky quet (phut) ===
# De trong de tu dong tinh theo so tu khoa (khong vuot 2200 query/24h).
# VD: POLL_INTERVAL_MINUTES=5
POLL_INTERVAL_MINUTES=

# === Duong dan (tuy chon) ===
DATA_DIR=data
KEYWORDS_PATH=keywords.json
